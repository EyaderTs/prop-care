# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=propcare

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from your Supabase project settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New projects use PUBLISHABLE_KEY (sb_publishable_xxx format)
# Legacy projects use ANON_KEY (JWT format starting with eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# =============================================================================
# Database Configuration (Drizzle)
# =============================================================================
# Use the transaction pooler URL (port 6543) for serverless / Vercel

DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# Google Calendar Integration
# =============================================================================
GOOGLE_CALENDAR_TIMEZONE=Africa/Addis_Ababa
# Paste the full service account JSON as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# =============================================================================
# Gemini AI
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# Email — Brevo (Sendinblue)
# =============================================================================
BREVO_API_KEY=xkeysib-your-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=PropCare · Meklit Tower

# =============================================================================
# App URL
# =============================================================================
# Set to your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# =============================================================================
# Cron / Escalation
# =============================================================================
# Secret used to authenticate requests to /api/cron/escalate
# Set the same value in GCP Cloud Scheduler as: Authorization: Bearer <secret>
CRON_SECRET=your-secret-here
